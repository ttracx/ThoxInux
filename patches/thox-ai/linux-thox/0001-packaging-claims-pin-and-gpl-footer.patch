@@ -87,6 +87,19 @@ if [ "$actual" != "$expected" ]; then
   echo "  actual:                $actual" >&2
   exit 1
 fi
+# Digests recorded from kernel.org sha256sums.asc on 2026-11-11.
+# Both the live sums file and this pin must match.
+case "$KVER" in
+  6.6.161) pinned=7d34405be5cd4989b2a5e9cbefa798e3a175218901271e034af3fe4e840b71c6 ;;
+  6.12.115) pinned=0ec90fe4b20422b1b664b77e6d2dde22b40bd41e7eb2cad8ac8739a4749cb1bb ;;
+  *) echo "ERROR: no pinned digest for linux-$KVER" >&2; exit 1 ;;
+esac
+if [ "$actual" != "$pinned" ]; then
+  echo "ERROR: sha256 does not match the digest pinned in this script" >&2
+  echo "  pinned: $pinned" >&2
+  echo "  actual: $actual" >&2
+  exit 1
+fi
 echo "-- sha256 verified: $actual"
 
