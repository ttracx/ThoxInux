diff --git a/kernel/ginux/scripts/prepare_source.py b/kernel/ginux/scripts/prepare_source.py
index fcea35f..592db2c 100644
--- a/kernel/ginux/scripts/prepare_source.py
+++ b/kernel/ginux/scripts/prepare_source.py
@@ -29,6 +29,12 @@ def patch_paths(patch_dir):
     return [patch_dir / n for n in names]
 
 
+# Installed after the patch series by the build scripts. It is a public
+# certificate, not a patched upstream file, and a second build must not
+# treat it as unknown source.
+ALLOWED_UNTRACKED = {"services/network/certs/thoxos-local-root.pem"}
+
+
 def prepare(root, commit, patch_dir):
     root, patch_dir = root.resolve(), patch_dir.resolve()
     if git(root, "rev-parse", "HEAD").decode().strip() != commit:
@@ -49,10 +55,16 @@ def prepare(root, commit, patch_dir):
         expected_bytes = {p: (expected / p).read_bytes() for p in expected_paths if p != generated}
         unknown = git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0")
         unknown = {p.decode() for p in unknown if p}
-        if unknown - expected_paths:
+        for extra in ALLOWED_UNTRACKED:
+            extra_path = root / extra
+            if extra_path.is_symlink():
+                raise ValueError("Refusing symlinked source files")
+        if (unknown - ALLOWED_UNTRACKED) - expected_paths:
             raise ValueError("Refusing untracked source files")
         if any((root / p).is_symlink() for p in expected_bytes):
             raise ValueError("Refusing symlinked source files")
+        # Keep the registry certificate in `unknown` so a second build does
+        # not look pristine and re-apply the series onto an already patched tree.
         pristine = not unknown and all((root / p).is_file() and (root / p).read_bytes() == b for p, b in originals.items())
         if pristine:
             for patch in patches:
@@ -61,6 +73,7 @@ def prepare(root, commit, patch_dir):
             if not (root / p).is_file() or (root / p).read_bytes() != expected_data:
                 raise ValueError("Source differs from reviewed patch series: " + p)
         actual_paths = set(paths(root)) | {p.decode() for p in git(root, "ls-files", "--others", "--exclude-standard", "-z").split(b"\0") if p}
+        actual_paths -= ALLOWED_UNTRACKED
         if actual_paths != expected_paths:
             raise ValueError("Tracked source inventory differs from reviewed patch series")
     return [p.name for p in patches]
diff --git a/kernel/ginux/scripts/run-vm.sh b/kernel/ginux/scripts/run-vm.sh
index 55597d7..b96e65c 100755
--- a/kernel/ginux/scripts/run-vm.sh
+++ b/kernel/ginux/scripts/run-vm.sh
@@ -37,6 +37,9 @@ fi
 for path in "$artifact_dir" "$state_dir"; do
     [[ "$path" != *','* && "$path" != *$'\n'* ]] || { echo "QEMU paths cannot contain commas or newlines" >&2; exit 2; }
 done
+# The ESP drive is passed as fat:rw:<state>/esp. A colon is a fat: field
+# separator, so it is not a safe character in the state directory.
+[[ "$state_dir" != *:* ]] || { echo "State directory cannot contain a colon" >&2; exit 2; }
 artifact_dir="$(realpath "$artifact_dir")"
 [[ -s "$artifact_dir/GINUX.EFI" && -s "$artifact_dir/SHA256SUMS" ]] || {
     echo "Missing built artifacts. Build or export the EFI first." >&2; exit 1;
