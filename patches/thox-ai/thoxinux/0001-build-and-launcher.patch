diff --git a/kernel/ginux/scripts/build-native.sh b/kernel/ginux/scripts/build-native.sh
index 130fbc1..5256e98 100755
--- a/kernel/ginux/scripts/build-native.sh
+++ b/kernel/ginux/scripts/build-native.sh
@@ -6,10 +6,22 @@ module_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
 source "$module_root/upstream.env"
 source_dir="${GINUX_SOURCE_DIR:-$module_root/.work/ginux}"
 out="${GINUX_ARTIFACT_DIR:-$module_root/artifacts}"
+# Match build-unified.sh: the PE TimeDateStamp and the receipt use the pin.
+if [[ -z "${SOURCE_DATE_EPOCH:-}" ]]; then
+    SOURCE_DATE_EPOCH="${GINUX_SOURCE_DATE_EPOCH:?GINUX_SOURCE_DATE_EPOCH missing from upstream.env}"
+fi
+export SOURCE_DATE_EPOCH
+export THOX_BUILD_SCRIPT="${THOX_BUILD_SCRIPT:-kernel/ginux/scripts/build-native.sh}"
 for cmd in git cargo rustc clang make python3; do
     command -v "$cmd" >/dev/null || { echo "Missing prerequisite: $cmd" >&2; exit 1; }
 done
 "$module_root/scripts/prepare-source.sh" "$source_dir"
+# thox-registry-anchor.patch compiles include_str! of this public certificate.
+# prepare-source.sh does not install it; without this copy the documented
+# build fails inside the network crate.
+pinned_anchor="$module_root/registry-anchor/thoxos-local-root.pem"
+[[ -f "$pinned_anchor" ]] || { echo "Pinned registry anchor missing: $pinned_anchor" >&2; exit 1; }
+install -m 0644 "$pinned_anchor" "$source_dir/services/network/certs/thoxos-local-root.pem"
 [[ "$(cd "$source_dir" && rustc --version | awk '{print $2}')" == "$GINUX_RUST_VERSION" ]] || {
     echo "Install Rust $GINUX_RUST_VERSION and x86_64-unknown-uefi/x86_64-unknown-none targets." >&2
     exit 1
